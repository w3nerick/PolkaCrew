{
  "name": "polkacrew",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "sync:cdm": "node scripts/sync-cdm.mjs",
    "predev": "npm run sync:cdm",
    "dev": "vite",
    "prebuild": "npm run sync:cdm",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run sync:cdm",
    "typecheck": "tsc -b --pretty false",
    "relay": "python3 relay_server.py",
    "contracts:install": "cd contracts-cdm && npm install",
    "contracts:build": "cd contracts-cdm && npm run build",
    "cdm:install": "cdm install @w3nerick/polkacrew-results -n devnet",
    "test:relay": "python3 scripts/test-relay-security.py"
  },
  "dependencies": {
    "@parity/product-sdk": "^0.22.0",
    "@parity/product-sdk-descriptors": "^0.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
